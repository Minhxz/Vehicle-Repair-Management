@{ ViewData["Title"] = "Tra cứu tiến độ sửa chữa"; }
<section class="tracking-section section-shell section-space"><div class="tracking-heading"><span class="eyebrow">CHIẾC XE CỦA BẠN, TRONG TẦM THEO DÕI</span><h1>Theo dõi từng bước.<br />An tâm từng hành trình.</h1><p>Nhập mã lịch hẹn và số điện thoại đã đăng ký để xem tiến độ.</p></div><form id="tracking-form" class="tracking-form"><div class="form-field"><label for="tracking-reference">Mã lịch hẹn <span>*</span></label><input id="tracking-reference" name="reference" placeholder="Ví dụ: AF-..." maxlength="40" required /></div><div class="form-field"><label for="tracking-phone">Số điện thoại <span>*</span></label><input id="tracking-phone" name="phone" type="tel" autocomplete="tel" placeholder="Số điện thoại đã đăng ký" maxlength="20" required /></div><button type="submit" class="button button-blue">TRA CỨU <span>↗</span></button></form><div id="tracking-message" class="form-message" role="status" hidden></div><div id="tracking-result" class="tracking-result" aria-live="polite" hidden></div><div class="tracking-empty" id="tracking-empty"><svg viewBox="0 0 48 48"><circle cx="21" cy="21" r="13"/><path d="m31 31 11 11M14 21l5 5 9-10"/></svg><h3>Thông tin hành trình chăm xe</h3><p>Lịch hẹn, tình trạng tiếp nhận và các bước sửa chữa<br />sẽ hiển thị tại đây sau khi tra cứu.</p><a href="/Home/Booking" class="text-link">CHƯA CÓ LỊCH HẸN? ĐẶT LỊCH NGAY ↗</a></div></section>
@section Scripts { <script src="~/js/tracking.js" asp-append-version="true" defer></script> }
