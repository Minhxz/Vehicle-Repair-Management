@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Đăng nhập quản lý — AutoFix ERP</title><link rel="stylesheet" href="~/css/login.css" asp-append-version="true" /></head>
<body>
    <main class="login-shell">
        <section class="login-story"><a class="login-brand" href="/">AUTO<span>FIX</span><small>CHĂM SÓC XE TOÀN DIỆN</small></a><div><span class="eyebrow">AUTO FIX WORKSPACE</span><h1>Vận hành thông minh.<br />Chăm sóc tận tâm.</h1><p>Một nơi để kết nối lịch hẹn, phiếu sửa chữa, phụ tùng và hành trình của mọi chiếc xe.</p><div class="story-points"><span>01 <b>Tiếp nhận & theo dõi</b></span><span>02 <b>Kiểm tra & sửa chữa</b></span><span>03 <b>Quản lý & phát triển</b></span></div></div><small class="story-footer">MỖI CHIẾC XE. MỘT SỰ AN TÂM.</small></section>
        <section class="login-form-panel"><a class="home-link" href="/">← Về trang chủ</a><div class="login-card"><span class="login-symbol">↗</span><span class="eyebrow">DÀNH CHO CỬA HÀNG</span><h2>Chào mừng trở lại</h2><p>Đăng nhập để quản lý cửa hàng của bạn.</p><form id="login-form" data-return-url="@ViewData["ReturnUrl"]"><label for="username">Tên đăng nhập</label><input id="username" name="username" autocomplete="username" placeholder="Nhập tên đăng nhập" required maxlength="100" /><label for="password">Mật khẩu</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" required maxlength="200" /><button id="password-toggle" type="button" aria-label="Hiện mật khẩu">Hiện</button></div><p id="login-message" role="status"></p><button id="login-button" type="submit">Đăng nhập <span>→</span></button></form>@if (HostEnvironment.EnvironmentName == "Development") { <div class="demo-info"><span>TÀI KHOẢN BÀI TẬP</span><p>Đăng nhập thử nghiệm: <strong>admin</strong> / <strong>123</strong></p></div> }<small class="login-footnote">Thông tin khách hàng được bảo vệ trong không gian quản lý.</small></div></section>
    </main>
    <script src="~/js/login.js" asp-append-version="true" defer></script>
</body>
</html>
