@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Kho phụ tùng";
    ViewData["ManagementPage"] = "Inventory";
}
@section Styles {
    <link rel="stylesheet" href="~/css/inventory.css" asp-append-version="true" />
}
<div class="page-heading">
    <div><h2>Quản lý phụ tùng</h2><p>Nhập số lượng tồn hiện tại khi thêm/sửa phụ tùng.</p></div>
    <button id="inventory-add" class="btn btn-primary" type="button">+ Thêm phụ tùng</button>
</div>
<p id="inventory-message" class="alert alert-danger" role="alert" hidden></p>
<section class="card" aria-label="Danh sách phụ tùng">
    <form id="inventory-search-form" class="inventory-search-form">
        <div><label for="inventory-search" class="form-label">Tìm phụ tùng</label><input id="inventory-search" class="form-control" type="search" maxlength="100" placeholder="Nhập mã hoặc tên phụ tùng" /></div>
        <button class="btn btn-primary" type="submit">Tìm kiếm</button>
        <button id="inventory-clear" class="btn btn-light" type="button">Xóa tìm kiếm</button>
    </form>
    <div id="inventory-table" class="table-responsive" aria-busy="true">
        <table class="table table-erp inventory-table mb-0">
            <caption class="visually-hidden">Danh sách phụ tùng và số lượng tồn hiện tại.</caption>
            <thead><tr><th scope="col">Mã phụ tùng</th><th scope="col">Tên phụ tùng</th><th scope="col">Đơn vị tính</th><th scope="col" class="text-end">Tồn hiện tại</th><th scope="col" class="text-end">Đơn giá</th><th scope="col">Thao tác</th></tr></thead>
            <tbody id="inventory-rows"><tr><td colspan="6" class="empty-block">Đang tải phụ tùng…</td></tr></tbody>
        </table>
    </div>
    <div class="list-pagination">
        <p id="inventory-summary" class="mb-0 text-muted" role="status" aria-live="polite">Đang tải dữ liệu…</p>
        <nav aria-label="Phân trang phụ tùng"><button id="inventory-prev" class="btn btn-light btn-sm" type="button" disabled>Trước</button><span id="inventory-page">Trang 1 / 1</span><button id="inventory-next" class="btn btn-light btn-sm" type="button" disabled>Sau</button></nav>
    </div>
</section>

<div id="inventory-edit-modal" class="modal fade" tabindex="-1" aria-labelledby="inventory-edit-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><form id="inventory-form" class="modal-content">
        <div class="modal-header"><h2 id="inventory-edit-title" class="modal-title">Thêm phụ tùng</h2><button class="btn-close" data-bs-dismiss="modal" type="button" aria-label="Đóng"></button></div>
        <div class="modal-body">
            <p id="inventory-form-message" class="alert alert-danger" role="alert" hidden></p>
            <div class="mb-3"><label for="inventory-sku" class="form-label">Mã phụ tùng *</label><input id="inventory-sku" class="form-control" required maxlength="30" placeholder="Ví dụ: PT001" /></div>
            <div class="mb-3"><label for="inventory-name" class="form-label">Tên phụ tùng *</label><input id="inventory-name" class="form-control" required maxlength="120" /></div>
            <div class="mb-3"><label for="inventory-unit" class="form-label">Đơn vị tính *</label><input id="inventory-unit" class="form-control" required maxlength="20" placeholder="Cái, bộ, chai…" /></div>
            <div class="row g-3">
                <div class="col-sm-6"><label for="inventory-stock" class="form-label">Số lượng tồn *</label><input id="inventory-stock" class="form-control" type="number" required min="0" max="1000000" step="1" /></div>
                <div class="col-sm-6"><label for="inventory-price" class="form-label">Đơn giá (VNĐ) *</label><input id="inventory-price" class="form-control" type="number" required min="0" max="100000000" step="1" /></div>
            </div>
            <p class="small text-muted mt-3 mb-0">Số lượng và đơn giá là số nguyên không âm. Số lượng tồn được cập nhật trực tiếp khi lưu.</p>
        </div>
        <div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">Hủy</button><button id="inventory-save" class="btn btn-primary" type="submit">Lưu phụ tùng</button></div>
    </form></div>
</div>
<div id="inventory-delete-modal" class="modal fade" tabindex="-1" aria-labelledby="inventory-delete-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 id="inventory-delete-title" class="modal-title">Xóa phụ tùng?</h2><button class="btn-close" data-bs-dismiss="modal" type="button" aria-label="Đóng"></button></div>
        <div class="modal-body"><p id="inventory-delete-name" class="inventory-delete-name"></p><p class="text-muted mb-0">Phụ tùng sẽ được xóa khỏi danh sách kho.</p><p id="inventory-delete-message" class="alert alert-danger mt-3 mb-0" role="alert" hidden></p></div>
        <div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">Giữ lại</button><button id="inventory-delete-confirm" class="btn btn-danger" type="button">Xóa phụ tùng</button></div>
    </div></div>
</div>
@section Scripts {
    <script src="~/js/inventory.js" asp-append-version="true" defer></script>
}
