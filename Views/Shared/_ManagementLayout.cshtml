@{
    var currentPage = ViewData["ManagementPage"]?.ToString() ?? "Workflow";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#4e73df" />
    <title>@ViewData["Title"] — AutoFix ERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/management.css" asp-append-version="true" />
</head>
<body class="erp-page">
    <svg class="svg-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <symbol id="icon-tool" viewBox="0 0 24 24"><path d="m14 6 4 4 3-3a6 6 0 0 1-7 7L7 21l-4-4 7-7a6 6 0 0 1 7-7l-3 3Z" /></symbol>
        <symbol id="icon-board" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16M15 4v16M6 8h0M12 8h0M18 8h0" /></symbol>
        <symbol id="icon-file" viewBox="0 0 24 24"><path d="M14 3H5v18h14V8l-5-5v5h5M8 12h8M8 16h5" /></symbol>
        <symbol id="icon-box" viewBox="0 0 24 24"><path d="m12 3 9 5v9l-9 5-9-5V8l9-5Zm0 9 9-4M12 12 3 8m9 4v10M7 5l9 5" /></symbol>
        <symbol id="icon-chart" viewBox="0 0 24 24"><path d="M4 3v18h17M8 16l4-5 4 2 5-7" /></symbol>
        <symbol id="icon-users" viewBox="0 0 24 24"><circle cx="9" cy="7" r="3" /><path d="M3 20v-2a6 6 0 0 1 12 0v2M16 4a3 3 0 0 1 0 6m2 4a5 5 0 0 1 3 4v2" /></symbol>
        <symbol id="icon-arrow" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6" /></symbol>
        <symbol id="icon-search" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6.5" /><path d="m15 15 6 6" /></symbol>
        <symbol id="icon-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
        <symbol id="icon-refresh" viewBox="0 0 24 24"><path d="M20 11a8 8 0 0 0-14-5L3 9m0-5v5h5M4 13a8 8 0 0 0 14 5l3-3m0 5v-5h-5" /></symbol>
        <symbol id="icon-out" viewBox="0 0 24 24"><path d="M9 4H4v16h5M9 12h12m-5-5 5 5-5 5" /></symbol>
        <symbol id="icon-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></symbol>
        <symbol id="icon-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
    </svg>
    <div class="sidebar-backdrop" id="sidebar-backdrop" hidden></div>
    <nav id="sidebar" aria-label="Quản lý cửa hàng">
        <a class="sidebar-brand" href="/Management/Workflow"><span class="brand-icon"><svg class="erp-icon"><use href="#icon-tool" /></svg></span><span>AutoFix <small>ERP</small></span></a>
        <span class="sidebar-caption">KHÔNG GIAN QUẢN LÝ</span>
        <ul class="nav-menu">
            <li><a class="nav-link @(currentPage == "Workflow" ? "active" : "")" href="/Management/Workflow"><svg class="erp-icon"><use href="#icon-board" /></svg>Quy trình sửa chữa</a></li>
            <li><a class="nav-link @(currentPage == "JobCard" ? "active" : "")" href="/Management/JobCard"><svg class="erp-icon"><use href="#icon-file" /></svg>Phiếu sửa chữa</a></li>
            <li><a class="nav-link @(currentPage == "Inventory" ? "active" : "")" href="/Management/Inventory"><svg class="erp-icon"><use href="#icon-box" /></svg>Kho phụ tùng</a></li>
            <li><a class="nav-link @(currentPage == "Analytics" ? "active" : "")" href="/Management/Analytics"><svg class="erp-icon"><use href="#icon-chart" /></svg>Báo cáo & doanh thu</a></li>
        </ul>
        <div class="sidebar-spacer"></div>
        <a href="/" class="sidebar-website">Xem website <svg class="erp-icon"><use href="#icon-arrow" /></svg></a>
        <div class="sidebar-account"><span class="avatar-sm">AD</span><div><strong>@(User.Identity?.Name ?? "admin")</strong><small>Quản lý cửa hàng</small></div><button class="erp-icon-button" id="logout-button" type="button" aria-label="Đăng xuất" title="Đăng xuất"><svg class="erp-icon"><use href="#icon-out" /></svg></button></div>
    </nav>
    <div id="main-wrapper">
        <header class="topbar"><div class="d-flex align-items-center gap-3"><button id="sidebar-toggle" class="erp-icon-button mobile-menu" type="button" aria-label="Mở menu" aria-expanded="false"><svg class="erp-icon"><use href="#icon-menu" /></svg></button><div><span class="topbar-eyebrow">AUTO FIX / WORKSPACE</span><h1 id="page-title">@ViewData["Title"]</h1></div></div><div class="topbar-right"><span id="workspace-date" class="text-muted"></span><a class="btn btn-light btn-sm" href="/">Về website <svg class="erp-icon"><use href="#icon-arrow" /></svg></a></div></header>
        <main class="content-area">@RenderBody()</main>
        <footer class="erp-footer"><span>AutoFix ERP</span><span>Chăm sóc mọi loại xe. Quản lý mọi hành trình.</span></footer>
    </div>
    <div class="erp-toast" id="erp-toast" role="status" hidden></div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/management.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
