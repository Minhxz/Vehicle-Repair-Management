@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Dịch vụ";
    ViewData["ManagementPage"] = "Services";
}
<div class="page-heading"><div><h2>Danh mục dịch vụ</h2><p>Cập nhật dịch vụ, giá tham khảo và thông tin hiển thị cho khách hàng.</p></div><button type="button" class="btn btn-primary" id="service-add">+ Thêm dịch vụ</button></div>
<div id="service-management-message" class="alert alert-danger" role="status" hidden></div>
<section class="card erp-card">
    <div class="card-header d-flex justify-content-between align-items-center gap-3 py-3 px-4"><h2 class="mb-0">Dịch vụ đang cung cấp</h2><button type="button" class="btn btn-sm btn-outline-secondary" id="service-refresh">Làm mới</button></div>
    <div class="table-responsive"><table class="table table-erp service-management-table mb-0"><thead><tr><th scope="col">Dịch vụ</th><th scope="col">Giá tham khảo</th><th scope="col">Thao tác</th></tr></thead><tbody id="service-rows"><tr><td colspan="3" class="text-center py-4">Đang tải dịch vụ…</td></tr></tbody></table></div>
</section>
<dialog id="service-edit-dialog" class="service-editor-dialog" aria-labelledby="service-edit-title">
    <form id="service-form">
        <div class="service-editor-heading"><h2 id="service-edit-title">Thêm dịch vụ</h2><button type="button" class="btn btn-light" id="service-editor-close" aria-label="Đóng">×</button></div>
        <div id="service-form-message" class="alert alert-danger" role="alert" hidden></div>
        <div class="mb-3"><label for="service-name" class="form-label">Tên dịch vụ *</label><input id="service-name" name="name" class="form-control" required minlength="2" maxlength="120" /></div>
        <div class="mb-3"><label for="service-price" class="form-label">Giá tham khảo (VNĐ) *</label><input id="service-price" name="price" class="form-control" type="number" min="0" max="100000000" step="1" required /><small class="text-muted">Giá thực tế được xác nhận sau khi kiểm tra xe.</small></div>
        <div class="mb-3"><label for="service-image" class="form-label">Ảnh dịch vụ</label><input id="service-image" class="form-control" type="file" accept="image/jpeg,image/png,image/webp" /><small class="text-muted">JPG, PNG hoặc WebP, tối đa 2 MB. Ảnh được tải khi lưu dịch vụ.</small><div class="service-image-preview"><img id="service-image-preview" alt="Ảnh dịch vụ" hidden /><button type="button" class="btn btn-sm btn-outline-secondary" id="service-image-remove" hidden>Bỏ ảnh</button></div></div>
        <div class="mb-3"><label id="service-description-label" class="form-label" for="service-description">Mô tả dịch vụ *</label><div class="service-editor-toolbar" role="toolbar" aria-label="Định dạng mô tả"><button type="button" data-editor-command="bold" title="In đậm" aria-label="In đậm"><strong>B</strong></button><button type="button" data-editor-command="italic" title="In nghiêng" aria-label="In nghiêng"><em>I</em></button><button type="button" data-editor-command="insertUnorderedList">• Danh sách</button><button type="button" data-editor-command="removeFormat">Bỏ định dạng</button></div><div id="service-description-editor" class="service-description-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-required="true" aria-labelledby="service-description-label" spellcheck="true"></div><textarea id="service-description" name="description" maxlength="6000" rows="5" hidden></textarea><small class="text-muted">Nhập mô tả, dùng thanh công cụ để in đậm, in nghiêng hoặc tạo danh sách.</small></div>
        <div class="service-editor-actions"><button type="button" class="btn btn-outline-secondary" id="service-editor-cancel">Hủy</button><button type="submit" class="btn btn-primary" id="service-save">Lưu dịch vụ</button></div>
    </form>
</dialog>
<dialog id="service-delete-dialog" class="service-delete-dialog" aria-labelledby="service-delete-title"><h2 id="service-delete-title">Xóa dịch vụ?</h2><p id="service-delete-name"></p><p class="text-muted">Dịch vụ đã được dùng trong lịch hẹn sẽ không thể xóa.</p><div id="service-delete-message" class="alert alert-danger" role="alert" hidden></div><div class="service-editor-actions"><button type="button" class="btn btn-outline-secondary" id="service-delete-cancel">Giữ lại</button><button type="button" class="btn btn-danger" id="service-delete-confirm">Xóa dịch vụ</button></div></dialog>
@section Scripts { <script src="~/js/service-management.js" asp-append-version="true" defer></script> }
