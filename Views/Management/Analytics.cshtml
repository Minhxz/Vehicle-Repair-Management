@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Doanh thu";
    ViewData["ManagementPage"] = "Analytics";
}
@section Styles { <link rel="stylesheet" href="~/css/revenue.css" asp-append-version="true" /> }

<div class="page-heading revenue-heading">
    <div><h2>Doanh thu</h2><p>Chỉ tính tiền đã ghi nhận thu từ lịch hoàn thành. Mỗi lịch hẹn có một khoản thu.</p></div>
    <button type="button" class="btn btn-primary" id="revenue-add">+ Ghi nhận tiền thu</button>
</div>

<div class="row g-3 mb-4 revenue-stats" aria-label="Tổng tiền đã thu">
    <div class="col-md-4"><section class="card h-100"><div class="card-body"><h2>Thu hôm nay</h2><strong id="revenue-today">—</strong><p>Toàn bộ khoản thu trong ngày hôm nay</p></div></section></div>
    <div class="col-md-4"><section class="card h-100"><div class="card-body"><h2>Thu tháng này</h2><strong id="revenue-month">—</strong><p>Toàn bộ khoản thu trong tháng hiện tại</p></div></section></div>
    <div class="col-md-4"><section class="card h-100 revenue-filtered-stat"><div class="card-body"><h2>Tổng thu theo bộ lọc</h2><strong id="revenue-total">—</strong><p id="revenue-range-label">Theo khoảng ngày thu đã chọn</p></div></section></div>
</div>

<div id="revenue-message" class="alert alert-danger" role="status" hidden></div>
<section class="card erp-card" aria-labelledby="revenue-list-title">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 py-3 px-4"><h2 class="mb-0" id="revenue-list-title">Sổ thu tiền</h2><button type="button" class="btn btn-sm btn-outline-secondary" id="revenue-refresh">Làm mới</button></div>
    <div class="card-body px-4 pb-0">
        <form id="revenue-filter" class="row g-3 align-items-end mb-4">
            <div class="col-sm-6 col-lg-3"><label class="form-label" for="revenue-from">Từ ngày thu</label><input class="form-control" id="revenue-from" name="from" type="date" /></div>
            <div class="col-sm-6 col-lg-3"><label class="form-label" for="revenue-to">Đến ngày thu</label><input class="form-control" id="revenue-to" name="to" type="date" /></div>
            <div class="col-lg-auto d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit">Lọc ngày thu</button><button class="btn btn-outline-secondary" id="revenue-current-month" type="button">Tháng này</button></div>
        </form>
    </div>
    <div class="table-responsive"><table class="table table-erp revenue-table mb-0"><thead><tr><th scope="col">Ngày thu</th><th scope="col">Mã lịch hẹn</th><th scope="col">Khách hàng</th><th scope="col">Dịch vụ</th><th scope="col" class="text-end">Tiền đã thu</th><th scope="col">Ghi chú</th><th scope="col">Thao tác</th></tr></thead><tbody id="revenue-rows"><tr><td colspan="7" class="empty-block">Đang tải sổ thu tiền…</td></tr></tbody></table></div>
    <div class="card-footer bg-white revenue-pagination"><span id="revenue-summary" class="text-muted" role="status">Đang tải…</span><nav class="d-flex align-items-center gap-2" aria-label="Phân trang sổ thu tiền"><button type="button" class="btn btn-sm btn-outline-secondary" id="revenue-previous" disabled>Trước</button><span id="revenue-page">Trang 1 / 1</span><button type="button" class="btn btn-sm btn-outline-secondary" id="revenue-next" disabled>Sau</button></nav></div>
</section>

<div class="modal fade" id="revenue-modal" tabindex="-1" aria-labelledby="revenue-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <form id="revenue-form">
            <div class="modal-header"><h2 class="modal-title" id="revenue-modal-title">Ghi nhận tiền thu</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <div id="revenue-form-message" class="alert alert-danger" role="alert" hidden></div>
                <div class="mb-3"><label for="revenue-reference" class="form-label">Lịch hẹn hoàn thành *</label><select id="revenue-reference" name="reference" class="form-select" required></select><p id="revenue-reference-help" class="text-muted mt-2 mb-0">Chỉ chọn lịch hoàn thành chưa ghi nhận tiền thu.</p></div>
                <div class="mb-3"><label for="revenue-amount" class="form-label">Tiền đã thu (VNĐ) *</label><input id="revenue-amount" name="amount" class="form-control" type="number" required min="1" max="100000000" step="1" inputmode="numeric" placeholder="Nhập số tiền thực tế đã thu" /><p class="text-muted mt-2 mb-0">Nhập số nguyên từ 1 đến 100.000.000 đồng.</p></div>
                <div class="mb-3"><label for="revenue-paid-on" class="form-label">Ngày thu *</label><input id="revenue-paid-on" name="paidOn" class="form-control" type="date" required /></div>
                <div><label for="revenue-note" class="form-label">Ghi chú</label><textarea id="revenue-note" name="note" class="form-control" maxlength="300" rows="3" placeholder="Ghi chú khoản thu, tối đa 300 ký tự"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-primary" id="revenue-save">Lưu khoản thu</button></div>
        </form>
    </div></div>
</div>
@section Scripts { <script src="~/js/analytics.js" asp-append-version="true" defer></script> }
