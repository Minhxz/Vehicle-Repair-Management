@{
    Layout = "_ManagementLayout";
    ViewData["Title"] = "Lịch hẹn";
    ViewData["ManagementPage"] = "Workflow";
}
<div class="page-heading">
    <div><h2>Theo dõi lịch hẹn</h2><p>Xem yêu cầu của khách hàng và cập nhật tiến độ sửa chữa.</p></div>
    <a class="btn btn-primary" href="/Home/Booking"><svg class="erp-icon" aria-hidden="true"><use href="#icon-plus" /></svg>Đặt lịch mới</a>
</div>
<p id="workflow-message" class="alert alert-danger" role="alert" hidden></p>
<section class="workflow-stats" aria-label="Tổng quan lịch hẹn">
    <div><span>Tổng lịch hẹn</span><strong id="stat-total">—</strong></div>
    <div><span>Chờ xác nhận</span><strong id="stat-pending">—</strong></div>
    <div><span>Đã tiếp nhận</span><strong id="stat-confirmed">—</strong></div>
    <div><span>Đang sửa</span><strong id="stat-in-progress">—</strong></div>
    <div><span>Hoàn thành</span><strong id="stat-completed">—</strong></div>
</section>
<section class="card" aria-label="Danh sách lịch hẹn">
    <form id="workflow-filters" class="workflow-filters">
        <div><label class="form-label" for="workflow-search">Tìm lịch hẹn</label><input id="workflow-search" class="form-control" type="search" maxlength="100" placeholder="Mã lịch, tên, SĐT hoặc biển số" /></div>
        <div><label class="form-label" for="workflow-status">Trạng thái</label><select id="workflow-status" class="form-select"><option value="">Tất cả trạng thái</option><option value="Pending">Chờ xác nhận</option><option value="Confirmed">Đã tiếp nhận</option><option value="InProgress">Đang sửa</option><option value="Completed">Hoàn thành</option><option value="Cancelled">Đã hủy</option></select></div>
        <div><label class="form-label" for="workflow-date">Ngày hẹn</label><input id="workflow-date" class="form-control" type="date" /></div>
        <div class="filter-actions"><button class="btn btn-primary" type="submit">Tìm kiếm</button><button id="workflow-reset" class="btn btn-light" type="button">Xóa lọc</button></div>
    </form>
    <div class="table-responsive" id="workflow-table" aria-busy="true">
        <table class="table table-erp appointment-table mb-0">
            <caption class="visually-hidden">Danh sách lịch hẹn sửa xe, dùng nút Chi tiết để cập nhật trạng thái.</caption>
            <thead><tr><th scope="col">Mã / Ngày hẹn</th><th scope="col">Khách hàng</th><th scope="col">Phương tiện</th><th scope="col">Dịch vụ</th><th scope="col">Trạng thái</th><th scope="col"><span class="visually-hidden">Thao tác</span></th></tr></thead>
            <tbody id="workflow-rows"><tr><td colspan="6" class="empty-block">Đang tải lịch hẹn…</td></tr></tbody>
        </table>
    </div>
    <div class="list-pagination">
        <p id="workflow-summary" class="mb-0 text-muted" role="status" aria-live="polite">Đang tải dữ liệu…</p>
        <nav aria-label="Phân trang lịch hẹn"><button id="workflow-prev" class="btn btn-light btn-sm" type="button" disabled>Trước</button><span id="workflow-page">Trang 1 / 1</span><button id="workflow-next" class="btn btn-light btn-sm" type="button" disabled>Sau</button></nav>
    </div>
</section>
<p class="workflow-help">Tiến độ: Chờ xác nhận → Đã tiếp nhận → Đang sửa → Hoàn thành. Có thể hủy trước khi bắt đầu sửa.</p>

<div class="modal fade" id="detail-modal" tabindex="-1" aria-labelledby="detail-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered"><form id="detail-form" class="modal-content">
        <div class="modal-header"><h2 class="modal-title" id="detail-title">Chi tiết lịch hẹn</h2><button class="btn-close" data-bs-dismiss="modal" type="button" aria-label="Đóng"></button></div>
        <div class="modal-body">
            <div id="detail-content" aria-live="polite"></div>
            <hr class="my-4" />
            <div class="mb-3"><label for="detail-status" class="form-label">Trạng thái xử lý</label><select id="detail-status" class="form-select" disabled></select><p id="detail-status-help" class="small text-muted mt-2 mb-0"></p></div>
            <label for="detail-note" class="form-label">Ghi chú xử lý</label><textarea id="detail-note" class="form-control" rows="4" maxlength="2000" placeholder="Kết quả kiểm tra, nội dung đã xử lý hoặc hướng dẫn nhận xe…" disabled></textarea>
            <p class="small text-muted mt-2 mb-0">Ghi chú này hiển thị cho khách khi tra cứu lịch hẹn.</p>
            <p id="detail-message" class="text-danger mt-3 mb-0" role="alert"></p>
        </div>
        <div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal" type="button">Đóng</button><button id="detail-save" class="btn btn-primary" type="submit" disabled>Lưu cập nhật</button></div>
    </form></div>
</div>
@section Scripts {
    <script src="~/js/workflow.js" asp-append-version="true" defer></script>
}
