@{ Layout = "_ManagementLayout"; ViewData["Title"] = "Phiếu sửa chữa"; ViewData["ManagementPage"] = "JobCard"; }
<div class="page-heading"><div><h2>Phiếu sửa chữa thông minh</h2><p>Kiểm tra, phân công và lập chi phí trong một phiếu.</p></div><div class="actions"><button id="job-reset" class="btn btn-light" type="button" disabled>Hoàn tác</button><button id="job-save" class="btn btn-primary" type="button" disabled><svg class="erp-icon"><use href="#icon-check" /></svg>Lưu phiếu</button></div></div>
<div class="card p-4 mb-4" id="job-select-card"><div class="row align-items-center g-3"><div class="col-md-4"><label for="job-reference" class="form-label mb-1">Chọn yêu cầu tiếp nhận</label><p class="text-muted small mb-0">Thông tin khách hàng được lấy từ lịch hẹn.</p></div><div class="col-md-8"><select class="form-select" id="job-reference" aria-label="Chọn xe cần lập phiếu"><option value="">Đang tải lịch hẹn…</option></select></div></div></div>
<p class="page-alert alert alert-danger" id="job-message" role="status" hidden></p>
<div id="job-empty" class="card empty-block" hidden><strong>Chưa có yêu cầu tiếp nhận</strong>Tạo lịch hẹn hoặc tiếp nhận xe để bắt đầu lập phiếu sửa chữa.<br /><a href="/Management/Workflow" class="btn btn-outline-primary mt-3">Tiếp nhận xe</a></div>
<article id="job-editor" class="card mb-4" hidden>
    <div class="jobcard-header"><div class="row g-4"><div class="col-md-4"><label class="form-label text-uppercase">Phương tiện</label><div class="job-information" id="job-vehicle"></div></div><div class="col-md-4"><label class="form-label text-uppercase">Khách hàng</label><div class="job-information" id="job-customer"></div></div><div class="col-md-4"><label for="job-technician" class="form-label text-uppercase">Phân công kỹ thuật</label><input id="job-technician" class="form-control mb-2" list="technician-list" maxlength="100" placeholder="Tên kỹ thuật viên phụ trách" /><datalist id="technician-list"></datalist><select id="job-status" class="form-select" aria-label="Trạng thái sửa chữa"><option value="Pending">Chờ xác nhận</option><option value="Confirmed">Đã tiếp nhận</option><option value="InProgress">Đang sửa chữa</option><option value="Completed">Đã hoàn thành</option><option value="Cancelled">Đã hủy</option></select></div></div></div>
    <ul class="nav nav-tabs nav-tabs-custom" id="job-tabs" role="tablist"><li class="nav-item" role="presentation"><button class="nav-link active" id="inspection-tab" data-bs-toggle="tab" data-bs-target="#tab-inspection" type="button" role="tab" aria-controls="tab-inspection" aria-selected="true">Kiểm tra & chẩn đoán</button></li><li class="nav-item" role="presentation"><button class="nav-link" id="parts-tab" data-bs-toggle="tab" data-bs-target="#tab-parts" type="button" role="tab" aria-controls="tab-parts" aria-selected="false">Phụ tùng & dịch vụ</button></li><li class="nav-item" role="presentation"><button class="nav-link" id="billing-tab" data-bs-toggle="tab" data-bs-target="#tab-billing" type="button" role="tab" aria-controls="tab-billing" aria-selected="false">Chi phí & thanh toán</button></li></ul>
    <div class="tab-content job-tab-content"><section class="tab-pane fade show active" id="tab-inspection" role="tabpanel" aria-labelledby="inspection-tab"><div class="row g-4"><div class="col-md-6"><h3 class="job-section-title">Danh mục kiểm tra trước sửa chữa</h3><label class="checklist-label"><input class="form-check-input" type="checkbox" value="Dầu động cơ / dung dịch" />Dầu động cơ / dung dịch</label><label class="checklist-label"><input class="form-check-input" type="checkbox" value="Hệ thống phanh" />Hệ thống phanh trước và sau</label><label class="checklist-label"><input class="form-check-input" type="checkbox" value="Lốp & áp suất" />Lốp, độ mòn và áp suất</label><label class="checklist-label"><input class="form-check-input" type="checkbox" value="Điện, đèn & tín hiệu" />Hệ thống điện, đèn và tín hiệu</label></div><div class="col-md-6"><label for="job-diagnosis" class="job-section-title d-block">Kết quả chẩn đoán / hướng sửa chữa</label><textarea id="job-diagnosis" class="form-control" rows="7" maxlength="1800" placeholder="Ghi nhận tình trạng, nguyên nhân và phương án xử lý…"></textarea><p class="small text-muted mt-3 mb-0" id="customer-note"></p></div></div></section>
    <section class="tab-pane fade" id="tab-parts" role="tabpanel" aria-labelledby="parts-tab"><div class="d-flex justify-content-between gap-3 mb-3 align-items-center"><h3 class="job-section-title mb-0">Danh sách phụ tùng & tiền công</h3><span class="small text-muted" id="job-line-count">0 hạng mục</span></div><datalist id="inventory-list"></datalist><div class="table-responsive"><table class="table table-erp" id="parts-table"><thead><tr><th>#</th><th style="min-width:220px">Hạng mục / dịch vụ</th><th style="min-width:130px">Loại</th><th style="min-width:85px">SL</th><th style="min-width:135px">Đơn giá (₫)</th><th style="min-width:140px">Thành tiền</th><th></th></tr></thead><tbody id="parts-body"></tbody></table></div><p class="small text-muted" id="parts-empty">Chưa có hạng mục. Thêm phụ tùng hoặc công sửa chữa để lập dự toán.</p><button type="button" class="btn btn-outline-primary btn-sm" id="add-line"><svg class="erp-icon"><use href="#icon-plus" /></svg>Thêm hạng mục</button></section>
    <section class="tab-pane fade" id="tab-billing" role="tabpanel" aria-labelledby="billing-tab"><div class="row g-4"><div class="col-lg-6"><h3 class="job-section-title">Thông tin thanh toán</h3><p class="text-muted small mb-4">Chi phí được tính từ phụ tùng và dịch vụ trên phiếu.</p><label for="job-discount" class="form-label">Giảm giá (₫)</label><input id="job-discount" type="number" class="form-control mb-3" min="0" step="1" value="0" /><label for="job-payment" class="form-label">Trạng thái thanh toán</label><select id="job-payment" class="form-select"><option value="Unpaid">Chưa thanh toán</option><option value="Paid">Đã thanh toán</option></select><p class="small text-muted mt-4" id="job-updated"></p></div><div class="col-lg-6"><div class="billing-box"><div class="billing-row"><span>Tạm tính</span><strong id="bill-subtotal">0 ₫</strong></div><div class="billing-row"><span>Giảm giá</span><strong class="text-success" id="bill-discount">0 ₫</strong></div><div class="billing-total"><span>Tổng cộng</span><strong id="bill-total">0 ₫</strong></div><button class="btn btn-success w-100 mt-4" id="confirm-payment" type="button">Xác nhận thanh toán & in</button><button class="btn btn-outline-secondary w-100 mt-2" id="print-job" type="button">In phiếu sửa chữa</button><small class="text-muted d-block mt-3">Đơn vị tiền tệ: Việt Nam đồng (VND).</small></div></div></div></section></div>
</article>
<section class="print-summary" id="print-summary"></section>
@section Scripts { <script src="~/js/jobcard.js" asp-append-version="true" defer></script> }
